# Hope School — environment variables
# Copy to .env and fill in real values.

# True for local dev, False in production
DEBUG=True

# Generate a strong random key for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# Comma-separated. In production: hopeschool.uz,www.hopeschool.uz
ALLOWED_HOSTS=*

# Production HTTPS origins, e.g. https://hopeschool.uz
CSRF_TRUSTED_ORIGINS=

# Telegram bot — applications are sent here
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
